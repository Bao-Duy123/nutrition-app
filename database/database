    -- ==================================================================================
    -- PHẦN 1: TẠO 10 BẢNG CHUẨN ĐÁP ỨNG 100% NGHIỆP VỤ CỦA 13 ẢNH MOCKUP
    -- ==================================================================================

    -- 1.1. Bảng Profiles (Hồ sơ người dùng & Chỉ số sinh trắc học BMR, TDEE)
    CREATE TABLE public.profiles (
      id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
      full_name TEXT,
      avatar_url TEXT,
      gender TEXT DEFAULT 'Nam',
      age INTEGER DEFAULT 25,
      height NUMERIC(5, 1) DEFAULT 170.0,
      current_weight NUMERIC(5, 2) DEFAULT 70.0,
      target_weight NUMERIC(5, 2) DEFAULT 65.0,
      activity_level TEXT DEFAULT 'light',
      bmr NUMERIC(7, 1) DEFAULT 1628.0,
      tdee NUMERIC(7, 1) DEFAULT 2239.0,
      daily_calorie_goal NUMERIC(7, 1) DEFAULT 1739.0,
      goal_type TEXT DEFAULT 'Giảm cân',
      target_days INTEGER DEFAULT 60,
      subscription_tier TEXT DEFAULT 'Pro',
      created_at TIMESTAMPTZ DEFAULT NOW(),
      updated_at TIMESTAMPTZ DEFAULT NOW()
    );

    -- 1.2. Bảng Foods (Kho thực phẩm món quán & nguyên liệu thô cân gram)
    CREATE TABLE public.foods (
      id BIGSERIAL PRIMARY KEY,
      name TEXT NOT NULL,
      food_type TEXT DEFAULT 'restaurant_dish',
      category TEXT DEFAULT 'pho',
      region TEXT DEFAULT 'Toàn quốc',
      serving_size TEXT NOT NULL DEFAULT '1 Tô tiêu chuẩn',
      calories NUMERIC(7, 1) NOT NULL DEFAULT 0,
      protein NUMERIC(6, 2) NOT NULL DEFAULT 0,
      carbs NUMERIC(6, 2) NOT NULL DEFAULT 0,
      fat NUMERIC(6, 2) NOT NULL DEFAULT 0,
      fiber NUMERIC(6, 2) DEFAULT 0,
      sodium NUMERIC(7, 2) DEFAULT 0,
      special_label TEXT DEFAULT 'Tô Lớn / Đặc Biệt',
      special_calories NUMERIC(7, 1),
      special_protein NUMERIC(6, 2),
      special_carbs NUMERIC(6, 2),
      special_fat NUMERIC(6, 2),
      toppings JSONB DEFAULT '[]'::jsonb,
      icon TEXT DEFAULT '🍽️',
      image_url TEXT,
      is_custom BOOLEAN DEFAULT FALSE,
      created_by UUID REFERENCES auth.users(id) ON DELETE SET NULL,
      created_at TIMESTAMPTZ DEFAULT NOW()
    );

    -- 1.3. Bảng Daily_Meals (Nhật ký bữa ăn từng buổi)
    CREATE TABLE public.daily_meals (
      id BIGSERIAL PRIMARY KEY,
      user_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
      food_id BIGINT REFERENCES public.foods(id) ON DELETE SET NULL,
      dish_name TEXT,
      meal_time TEXT NOT NULL DEFAULT 'Trưa',
      meal_source TEXT DEFAULT 'eating_out',
      quantity NUMERIC(4, 2) DEFAULT 1.0,
      serving_size TEXT DEFAULT '1 phần',
      calories NUMERIC(7, 1) NOT NULL DEFAULT 0,
      protein NUMERIC(6, 2) NOT NULL DEFAULT 0,
      carbs NUMERIC(6, 2) NOT NULL DEFAULT 0,
      fat NUMERIC(6, 2) NOT NULL DEFAULT 0,
      fiber NUMERIC(6, 2) DEFAULT 0,
      sodium NUMERIC(7, 2) DEFAULT 0,
      items_detail JSONB DEFAULT '{}'::jsonb,
      image_url TEXT,
      consumed_time TIME DEFAULT CURRENT_TIME,
      consumed_date DATE NOT NULL DEFAULT CURRENT_DATE,
      created_at TIMESTAMPTZ DEFAULT NOW()
    );

    -- 1.4. Bảng Weight_History (Tiến trình cân nặng theo ngày)
    CREATE TABLE public.weight_history (
      id BIGSERIAL PRIMARY KEY,
      user_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
      weight NUMERIC(5, 2) NOT NULL,
      recorded_date DATE NOT NULL DEFAULT CURRENT_DATE,
      notes TEXT,
      created_at TIMESTAMPTZ DEFAULT NOW(),
      UNIQUE (user_id, recorded_date)
    );

    -- 1.5. Bảng User_Recipes (Sổ tay công thức món tự nấu)
    CREATE TABLE public.user_recipes (
      id BIGSERIAL PRIMARY KEY,
      user_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
      recipe_name TEXT NOT NULL,
      cooking_method TEXT DEFAULT 'none',
      total_weight NUMERIC(7, 2) NOT NULL DEFAULT 0,
      total_calories NUMERIC(7, 1) NOT NULL DEFAULT 0,
      protein NUMERIC(6, 2) NOT NULL DEFAULT 0,
      carbs NUMERIC(6, 2) NOT NULL DEFAULT 0,
      fat NUMERIC(6, 2) NOT NULL DEFAULT 0,
      ingredients_json JSONB NOT NULL DEFAULT '[]'::jsonb,
      created_at TIMESTAMPTZ DEFAULT NOW()
    );

    -- 1.6. Bảng Water_Logs (Theo dõi lượng nước uống)
    CREATE TABLE public.water_logs (
      id BIGSERIAL PRIMARY KEY,
      user_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
      amount_ml INTEGER NOT NULL DEFAULT 250,
      consumed_date DATE NOT NULL DEFAULT CURRENT_DATE,
      consumed_time TIME DEFAULT CURRENT_TIME,
      created_at TIMESTAMPTZ DEFAULT NOW()
    );

    -- 1.7. Bảng User_Reminders (Cấu hình thông báo & nhắc nhở)
    CREATE TABLE public.user_reminders (
      user_id UUID PRIMARY KEY REFERENCES public.profiles(id) ON DELETE CASCADE,
      all_notifications_enabled BOOLEAN DEFAULT TRUE,
      water_reminder_enabled BOOLEAN DEFAULT TRUE,
      water_interval_hours NUMERIC(3, 1) DEFAULT 2.0,
      water_start_time TIME DEFAULT '07:00:00',
      water_end_time TIME DEFAULT '21:30:00',
      water_sound_and_vibrate BOOLEAN DEFAULT TRUE,
      breakfast_reminder_enabled BOOLEAN DEFAULT TRUE,
      breakfast_time TIME DEFAULT '08:00:00',
      lunch_reminder_enabled BOOLEAN DEFAULT TRUE,
      lunch_time TIME DEFAULT '12:30:00',
      dinner_reminder_enabled BOOLEAN DEFAULT TRUE,
      dinner_time TIME DEFAULT '19:30:00',
      snack_reminder_enabled BOOLEAN DEFAULT FALSE,
      snack_time TIME DEFAULT '15:30:00',
      weight_reminder_enabled BOOLEAN DEFAULT TRUE,
      weight_day_of_week TEXT DEFAULT 'Chủ Nhật',
      weight_time TIME DEFAULT '07:30:00',
      updated_at TIMESTAMPTZ DEFAULT NOW()
    );

    -- 1.8. Bảng User_Favorite_Foods (Món ăn yêu thích / Bookmark)
    CREATE TABLE public.user_favorite_foods (
      id BIGSERIAL PRIMARY KEY,
      user_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
      food_id BIGINT REFERENCES public.foods(id) ON DELETE CASCADE,
      custom_name TEXT,
      created_at TIMESTAMPTZ DEFAULT NOW(),
      UNIQUE (user_id, food_id)
    );

    -- 1.9. Bảng AI_Nutrition_Logs (Lịch sử bóc tách Gemini Pro AI)
    CREATE TABLE public.ai_nutrition_logs (
      id BIGSERIAL PRIMARY KEY,
      user_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
      raw_input_text TEXT NOT NULL,
      parsed_result JSONB NOT NULL,
      estimated_calories NUMERIC(7, 1),
      accuracy_rate NUMERIC(4, 1) DEFAULT 96.0,
      created_at TIMESTAMPTZ DEFAULT NOW()
    );

    -- 1.10. Bảng User_Devices (Quản lý thiết bị đồng bộ & push tokens)
    CREATE TABLE public.user_devices (
      id BIGSERIAL PRIMARY KEY,
      user_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
      device_name TEXT NOT NULL,
      device_type TEXT DEFAULT 'mobile',
      push_token TEXT,
      last_active TIMESTAMPTZ DEFAULT NOW(),
      created_at TIMESTAMPTZ DEFAULT NOW()
    );

